# ☁️ VINX CLOUD - ENVIRONMENT CONFIGURATION

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated list of Telegram User IDs who have Admin permissions (Required)
ADMIN_IDS=123456789,987654321

# Private Telegram Channel ID used as the cloud backend storage (Required)
# Note: Bot must be added to this channel as an Administrator with post/edit permissions
BACKEND_CHANNEL_ID=-1001234567890

# Support Username without @ symbol (Optional)
SUPPORT_USERNAME=vinx_support

# Path to SQLite Database file (Default: vinx_cloud.db)
DATABASE_PATH=vinx_cloud.db

# Default User Storage Limit in Bytes (Default: 1 TB = 1099511627776 bytes)
DEFAULT_STORAGE=1099511627776

# Force Join System Enabled by Default (true/false)
FORCE_JOIN_ENABLED=false

# Maximum single upload size limit in bytes (Default: 2 GB = 2147483648 bytes)
MAX_FILE_SIZE=2147483648
